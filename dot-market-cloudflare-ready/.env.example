# 총괄 관리자 ChatGPT 계정 이메일
SUPER_ADMIN_EMAIL=owner@example.com

# openssl rand -hex 32 등으로 생성한 32바이트 이상 비밀값
WEBHOOK_ENCRYPTION_KEY=replace-with-a-long-random-secret

# Cloudflare Turnstile 위젯에서 발급한 키
TURNSTILE_SITE_KEY=replace-with-your-public-site-key
TURNSTILE_SECRET_KEY=replace-with-your-secret-key

