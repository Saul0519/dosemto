{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dot-market",
  "compatibility_date": "2026-07-31",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./worker/index.ts",

  "workers_dev": false,
  "preview_urls": false,

  "observability": {
    "enabled": true
  },

  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dot-market-db",
      "database_id": "02037e2f-ad98-4bb5-991a-a589187a08af",
      "migrations_dir": "drizzle"
    }
  ],

  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "dot-market-files"
    }
  ],

  // Deploying replaces the Worker's plain-text variables with exactly this list,
  // so anything added only in the dashboard is wiped on the next build. Public
  // values belong here; secrets stay as Secrets, which deploys do not touch.
  "vars": {
    "SUPER_ADMIN_EMAIL": "sihyung0519@gmail.com",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAEC_4kj8JOBejss_",
    // Public half of the Mc-Auth credentials; it is visible in the login URL.
    // The matching MC_AUTH_CLIENT_SECRET must be set as a Secret.
    "MC_AUTH_CLIENT_ID": "3955111840157009112"
  }
}
