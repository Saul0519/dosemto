{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dot-market",
  // Keep this at or below the date supported by the workerd that
  // @cloudflare/vite-plugin pins, otherwise `vite` cannot start the local runtime.
  "compatibility_date": "2026-05-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./worker/index.ts",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dot-market-db",
      // Replace this placeholder with the Database ID shown by Cloudflare D1.
      "database_id": "02037e2f-ad98-4bb5-991a-a589187a08af",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "dot-market-files"
    }
  ],
  "vars": {
    "SUPER_ADMIN_EMAIL": "sihyung0519@gmail.com",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAEC_4kj8JOBejss_"
  }
}
